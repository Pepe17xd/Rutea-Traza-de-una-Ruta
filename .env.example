# Copiar a .env en la raíz. Las credenciales temporales AWS se guardan fuera
# del repositorio mediante AWS CLI; no agregar access keys ni session tokens.
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
AWS_PROFILE=default
AWS_STAGE=academy

# Generar un hash Argon2id con `python scripts/hash-operator-password.py`.
# El hash y la clave de sesión son configuración privada del backend, nunca Vite.
HECTOR_OPERATOR_PASSWORD_HASH=
HECTOR_SESSION_SIGNING_KEY=
HECTOR_SESSION_TTL_S=28800
HECTOR_SESSION_COOKIE_SECURE=true
HECTOR_AUTH_LOGIN_ATTEMPTS=5
HECTOR_AUTH_LOGIN_WINDOW_S=900
HECTOR_DEVICE_TOKEN=
HECTOR_REQUIRE_AUTH=true
HECTOR_TELEMETRY_MAX_AGE_S=15
HECTOR_TELEMETRY_MAX_ACCURACY_M=25
HECTOR_TELEMETRY_RETENTION_DAYS=30
HECTOR_DESTINATION_TTL_S=45
MISSIONS_TABLE=
TELEMETRY_TABLE=
RUTEA_CREATE_DYNAMO_TABLES=false

# Frontend público; no admite contraseñas ni tokens de operador.
VITE_ROBOT_ID=CAR_01
VITE_POLL_INTERVAL_MS=15000
VITE_MISSION_POLL_INTERVAL_MS=15000
VITE_MAP_STYLE_URL=

# Firmware, solo para compilación local; nunca son credenciales de AWS.
HECTOR_WIFI_SSID=
HECTOR_WIFI_PASSWORD=
HECTOR_API_BASE_URL=
HECTOR_DEVICE_ID=CAR_01
HECTOR_DEVICE_TOKEN=
